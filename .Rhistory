t.power <- function(mu.a) {
# VALUES FROM QUESTION 3
s <- 1.23   # sample standard deviation
n <- 17     # sample size
alpha <- 0.1  # significance level
mu.0 <- 220   # null value
# Calculating the degrees of freedom,
# which is (n-1) for a sample t-test
df <- n - 1
# Under the alterntaive hypothesis, the test statitic
# fllows a noncentral t distribution with non centrality parameter
# delta = (true mean - null mean)/standard error
delta <- (mu.a - mu.0) / (s / sqrt(n))
# Critical value for two-sided test
# the qt() function finds the t critical value
critical <- qt(1 - alpha/2, df)
# Power calculation
# Probability of rejecting H0 under alternative mu.a
power <- pt(-critical, df, ncp = delta) + (1 - pt(critical, df, ncp = delta))
return(power)
}
t.power (220.49)
t.power (220.42)
t.power <- function(mu.a) {
# VALUES FROM QUESTION 3
s <- 1.23 # sample standard deviation
n <- 17 # sample size
alpha <- 0.1 # significance level
mu.0 <- 220 # null value
# calculate critical value t_{n-1}(alpha)
t.a <- qt(p = 1-alpha, df = n-1)
# calculate t-score for mu_a
t.stat <- (mu.a-mu.0)/(s/sqrt(n))
# calculate probability of retaining H_0 if H_a is true
beta <- pt(q = t.a-t.stat, df = n-1)
# calculate power
power <- 1-beta
return(power)
}
# TEST THE FUNCTION
t.power(220.42)
t.power (220.49)
