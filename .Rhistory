t.power <- function(mu.a) {
# VALUES FROM QUESTION 3
s <- 1.23    # sample standard deviation
n <- 17      # sample size
alpha <- 0.1 # significance level
mu.0 <- 220  # null value
# POWER CALCULATIONS GO HERE
t <- qt(1-alpha, df=n-1) #Find t_{n-1}
SE <- s / sqrt(n) #Standard Error
# Power = P(T > t) where T ~ ((mu.a - mu.0)/SE, 1)
power <- 1-pt(t, df=n-1, ncp=(mu.a - mu.0)/SE, 1)
return(power)
}
print(t.power(220.74))
